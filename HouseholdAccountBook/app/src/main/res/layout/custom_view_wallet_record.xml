<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:id="@+id/wallet_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:text="ゆうちょ銀行"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/background_view"
        app:layout_constraintTop_toTopOf="@id/background_view"
        app:layout_constraintBottom_toBottomOf="@id/background_view"/>

    <ImageView
        android:id="@+id/list_sate_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/keyboard_arrow_down_24px"
        app:layout_constraintBottom_toBottomOf="@id/background_view"
        app:layout_constraintEnd_toEndOf="@id/background_view"
        app:layout_constraintTop_toTopOf="@id/background_view" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:weightSum="2"
        android:gravity="end"
        app:layout_constraintBottom_toBottomOf="@id/background_view"
        app:layout_constraintEnd_toStartOf="@id/list_sate_view"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@id/wallet_text"
        app:layout_constraintTop_toTopOf="@id/background_view">

        <TextView
            android:id="@+id/total_amount_text"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="10000000"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@id/bop_amount_text"
            app:layout_constraintEnd_toStartOf="@id/list_sate_view"
            app:layout_constraintTop_toTopOf="@id/background_view" />

        <TextView
            android:id="@+id/bop_amount_text"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="1000"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@id/wallet_text"
            app:layout_constraintEnd_toStartOf="@id/list_sate_view" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>