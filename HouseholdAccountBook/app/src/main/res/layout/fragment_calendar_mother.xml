<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/calendar_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/NavTabLayoutStyle"
        app:tabIndicatorFullWidth="true"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="収支" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ウォレット" />
    </com.google.android.material.tabs.TabLayout>
    <com.example.householdaccountbook.customviews.DateSelectorCustomView
        android:id="@+id/date_select_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendar_tab"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/calendar_fragment_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/date_select_view"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>